# ── Snowflake Terraform user credentials ─────────────────────────────────────
# Copy this file to .env and fill in your account details.
# .env is gitignored — never commit it.
#
# Snowflake account identifier:
#   SNOWFLAKE_ORGANIZATION_NAME + SNOWFLAKE_ACCOUNT_NAME (found in Snowsight → Admin → Accounts)
# Region: e.g. eu-west-2, us-east-1, ap-southeast-2
#
# Separate Terraform users per environment are recommended (see bootstrap docs).
#
# ── Private key ───────────────────────────────────────────────────────────────
# The Snowflake private key is NOT stored here.
# It is loaded automatically at runtime by scripts/load-env.sh from:
#   dev  → ~/.ssh/<your_private_key_file>.p8
#   prod → ~/.ssh/<your_private_key_file>.p8
# and exported as SNOWFLAKE_PRIVATE_KEY.
# See the Bootstrap section in README.md for keypair generation instructions.

SNOWFLAKE_USER_DEV=TERRAFORM_DEV
SNOWFLAKE_USER_PROD=TERRAFORM_PROD
SNOWFLAKE_ACCOUNT_NAME=<your-account-name>
SNOWFLAKE_ORGANIZATION_NAME=<your-org-name>
SNOWFLAKE_REGION=<your-region>
TFC_ORGANIZATION=<your-terraform-cloud-org>

# ── Private key paths (used by scripts/load-env.sh, not by Terraform directly) ─
# Point these to your PKCS8 PEM keypair files on the local machine.
# The file contents are read and exported as SNOWFLAKE_PRIVATE_KEY at runtime — do not set it here.
SNOWFLAKE_PRIVATE_KEY_PATH_DEV=~/.ssh/<your-dev-key>.p8
SNOWFLAKE_PRIVATE_KEY_PATH_PROD=~/.ssh/<your-prod-key>.p8

# ── Terraform Cloud token ─────────────────────────────────────────────────────
# Generate at: https://app.terraform.io → User Settings → Tokens → Create an API token
# This is required for terraform init (remote backend on HCP Terraform).
TF_TOKEN_app_terraform_io=<your-terraform-cloud-token>
